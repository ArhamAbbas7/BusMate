# ---- Server ----
PORT=4000
# Public URL used inside WhatsApp messages (map links, signup links)
PUBLIC_BASE_URL=http://localhost:4000
# Change this before going live. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
# Business timezone - cohort windows (1st-5th, 15th-19th) are computed in this zone
APP_TIMEZONE=Asia/Karachi
DEFAULT_COUNTRY_CODE=92

# ---- Database ----
# Leave empty to use the built-in embedded Postgres (stored in backend/data/pglite).
# Set to a real Postgres URL later, e.g. Azure: postgres://user:pass@host:5432/evbus?sslmode=require
DATABASE_URL=
SEED_ON_EMPTY=true

# ---- Messaging (WhatsApp) ----
# console  = messages go to the in-app Outbox (Developer console > Outbox). No phone needed.
# whatsapp = real WhatsApp Cloud API (fill in the values below)
MESSAGING_CHANNEL=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# template = use approved message templates (required for messages you start)
# text     = plain text, only works inside 24h of the user messaging you (handy for testing with your own number)
WHATSAPP_SEND_MODE=template
WHATSAPP_TEMPLATE_LANG=en
# Show conductor OTP codes on screen (dev only). Turn off once WhatsApp/SMS is connected.
EXPOSE_DEV_OTP=true

# ---- Storage ----
# Payment proof screenshots. Local folder for now; swap for Azure Blob later.
UPLOAD_DIR=uploads

# ---- Hosting ----
# Only needed if the frontend is hosted on a different domain from the API (comma-separated origins)
CORS_ORIGIN=

# ---- Map ----
# Default map centre "lat,lng" used when a route has no path yet
MAP_CENTER=31.5204,74.3587
